# ═══════════════════════════════════════════════════════════════
# ZeroID — TESTNET frontend config (accurate var names, matches the code)
# ═══════════════════════════════════════════════════════════════
# For a production-optimised testnet frontend, copy this file to
# `.env.production.local` and fill the addresses BEFORE `npm run build`.
# The names below are the ones the code actually reads (src/config/chains.ts,
# src/config/constants.ts). Only NEXT_PUBLIC_* vars reach the browser.

# ── Network ────────────────────────────────────────────────────
# Selects the testnet chain (id 7332) as active.
NEXT_PUBLIC_CHAIN_ENV=testnet
# EVM RPC — point at a validator's PUBLIC IP (the *.aethelred.network domains are
# not deployed). This is the var chains.ts reads for the testnet chain:
NEXT_PUBLIC_AETHELRED_TESTNET_RPC_URL=http://54.165.44.130:8545

# Backend identity API (the :4003 service). REQUIRED — the dashboard and most
# screens fetch from here ("Failed to load identity" means this is unset). The
# code reads NEXT_PUBLIC_ZEROID_API_URL (constants.ts); if unset it falls back to
# the never-deployed https://api.zeroid.aethelred.network → net::ERR_NAME_NOT_RESOLVED.
# This URL is resolved by the BROWSER, so use the host reachable from the browser:
#   - backend on the same box as the browser (typical dApps setup) → http://localhost:4003
#   - browser remote / backend on the dApps box → http://<dApps-box-IP>:4003
#     (open port 4003 and add that page's origin to the backend's CORS_ORIGINS)
# Note: this is NOT necessarily the RPC host above — the RPC runs on a validator,
# the API on the dApps box.
NEXT_PUBLIC_ZEROID_API_URL=http://localhost:4003

# Next.js server-side API routes proxy a small set of proof/credential requests
# to this URL. `next start` is a production runtime and therefore requires an
# HTTPS URL on a public hostname. Terminate TLS in a reverse proxy in front of
# the backend; this URL must not contain credentials, a query, or a fragment.
ZEROID_BACKEND_API_URL=https://api.zeroid.example

# ── Core identity contracts (from DeployIdentity.s.sol output) ──
# Fill these with the addresses the deploy prints. Until then they default to
# empty and those screens stay inert (the app still renders + wallet connects).
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_ZK_VERIFIER_ADDRESS=
NEXT_PUBLIC_ACCUMULATOR_REVOCATION_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_MODULE_ADDRESS=
NEXT_PUBLIC_CREDENTIAL_REGISTRY_ADDRESS=
NEXT_PUBLIC_SELECTIVE_DISCLOSURE_ADDRESS=

# ── Not deployed on this chain (leave empty) ───────────────────
# AETHEL is the NATIVE coin (precisebank), not an ERC-20; there is no standalone
# TEE-attestation contract in the current suite.
NEXT_PUBLIC_AETHEL_TOKEN_ADDRESS=
NEXT_PUBLIC_TEE_ATTESTATION_ADDRESS=

# ── Optional ───────────────────────────────────────────────────
# WalletConnect is NOT wired in the current wagmi config (only the injected
# connector is enabled), so no projectId is needed to connect a browser wallet.
# The KMS, TEE, sanctions, gov-API, bridge, and marketplace vars from .env.example
# are for the full production platform and are NOT needed for a testnet render +
# wallet connect + reading the core contracts above. (The backend API URL above,
# however, IS required — it drives identity/credential/verification screens.)

# Enterprise identity-assurance steps in the registration wizard. Off by default,
# so testnet onboarding is just Connect Wallet → Register. Enable (and configure
# the matching backend credentials) only for a gov/enterprise deployment. These
# are read at build time, so set them BEFORE `npm run build`.
# NEXT_PUBLIC_UAE_PASS_ENABLED=true        # UAE Pass government-ID verification step
# NEXT_PUBLIC_TEE_BIOMETRIC_ENABLED=true   # TEE biometric liveness step
