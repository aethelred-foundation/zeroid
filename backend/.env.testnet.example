# ═══════════════════════════════════════════════════════════════
# ZeroID backend — TESTNET config. Copy to `.env` and set JWT_SECRET.
# ═══════════════════════════════════════════════════════════════
# Boot requires: JWT_SECRET (>=32 chars), DATABASE_URL, REDIS_URL, PORT.
# docker-compose overrides DATABASE_URL / REDIS_URL / PORT to the stack
# services; the values here are for running the API natively (no Docker).

# Keep NON-production on testnet so local credential signing is permitted
# (production-safety only enforces KMS when NODE_ENV/ZEROID_ENV = production).
NODE_ENV=development
PORT=4003

# Native-run datastore URLs (ignored under docker compose, which points at the
# postgres/redis services instead).
DATABASE_URL=postgresql://zeroid:zeroid@localhost:5432/zeroid
REDIS_URL=redis://localhost:6379

# API auth signing — MUST be >=32 chars. Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# Credential signing custody: local dev signing on testnet; switch to a KMS
# provider (aws-kms | gcp-kms | azure-kms) + KMS_KEY_ID for production.
KMS_PROVIDER=local

LOG_LEVEL=info

# Allow the frontend origin(s) to call the API.
CORS_ORIGINS=http://localhost:3003

# ── Optional / disabled on testnet ─────────────────────────────
# Enterprise features (Emirates ID / UAE Pass gov verification, Intel SGX TEE
# attestation, OIDC provider, sanctions feeds, regulatory submission) require
# real external credentials and are NOT needed to boot the core API. Leave
# unset; keep every production-safety gate at its safe default:
#   ALLOW_LOCAL_CREDENTIAL_SIGNING is irrelevant off-production (local is allowed);
#   in production it MUST be false with a real KMS provider instead.
