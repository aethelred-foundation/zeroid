# ZeroID frontend build configuration
#
# This file is intentionally frontend-only. The API has a separate template at
# backend/.env.testnet.example. For the public-testnet procedure and deployment
# gates, use deployments/PUBLIC_TESTNET_RUNBOOK.md.
#
# Copy to .env.production.local before `npm run build`. Every NEXT_PUBLIC_ value
# is embedded in the browser bundle and is not a secret.

# Network selection and browser-reachable Aethelred JSON-RPC.
NEXT_PUBLIC_CHAIN_ENV=testnet
NEXT_PUBLIC_AETHELRED_NETWORK=testnet
NEXT_PUBLIC_ZEROID_ENV=testnet
NEXT_PUBLIC_AETHELRED_TESTNET_RPC_URL=http://<rpc-host>:8545

# Browser-facing API URL. Keep the legacy alias equal to the canonical value
# while older feature surfaces still read it.
NEXT_PUBLIC_ZEROID_API_URL=http://<application-host>:4003
NEXT_PUBLIC_API_URL=http://<application-host>:4003

# Server-side API URL used by Next.js routes. Use the loopback address when the
# frontend and API run on the same host.
ZEROID_BACKEND_API_URL=http://127.0.0.1:4003
ZEROID_BACKEND_FETCH_TIMEOUT_MS=5000

# Temporary public-testnet exception for exact HTTP/WS origins. Set false after
# TLS terminates in front of the frontend, API, and RPC.
ZEROID_ALLOW_PLAINTEXT_HTTP=true

# Canonical six-contract identity deployment. Populate these from
# deployments/7332.json with scripts/apply-deployment-manifest.mjs.
# Registration write target and paused() pre-flight target. The API verifies
# every registration against its own IDENTITY_REGISTRY_ADDRESS, so this value
# MUST be the same manifest identityRegistry the API is configured with, and
# NEXT_PUBLIC_CHAIN_ENV must be a DID network the API allows for its
# AETHELRED_CHAIN_ID (7332 -> testnet|devnet, 7331 -> mainnet) or registration
# answers 400 IDENTITY_DID_NETWORK_MISMATCH. Until the API has AETHELRED_RPC_URL
# and IDENTITY_REGISTRY_ADDRESS set, registration answers 503
# IDENTITY_REGISTRY_NOT_CONFIGURED and the wizard shows it as unavailable.
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_ZK_VERIFIER_ADDRESS=
NEXT_PUBLIC_ACCUMULATOR_REVOCATION_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_MODULE_ADDRESS=
NEXT_PUBLIC_CREDENTIAL_REGISTRY_ADDRESS=
NEXT_PUBLIC_SELECTIVE_DISCLOSURE_ADDRESS=

# These contracts are not part of the six-contract public-testnet deployment.
# Leave them empty unless a separately reviewed deployment manifest exists.
NEXT_PUBLIC_AETHEL_TOKEN_ADDRESS=
NEXT_PUBLIC_TEE_ATTESTATION_ADDRESS=
NEXT_PUBLIC_BBS_PLUS_ADDRESS=
NEXT_PUBLIC_THRESHOLD_CREDENTIAL_ADDRESS=
NEXT_PUBLIC_BRIDGE_CONTRACT_ADDRESS=
NEXT_PUBLIC_REGULATORY_COMPLIANCE_ADDRESS=

# Cryptographic activation gates. Keep false/empty until the corresponding
# ceremony artifacts and on-chain registrations have been independently
# reviewed and smoke-tested.
NEXT_PUBLIC_CANONICAL_VERIFY=false
NEXT_PUBLIC_AETHELRED_VKEYS={}
NEXT_PUBLIC_PQC_SIGNING=false
NEXT_PUBLIC_ZK_CIRCUIT_BASE_URL=/circuits

# Optional enterprise identity steps. They are disabled for the base public
# testnet and require matching backend integrations before activation.
NEXT_PUBLIC_UAE_PASS_ENABLED=false
NEXT_PUBLIC_TEE_BIOMETRIC_ENABLED=false
NEXT_PUBLIC_ZEROID_ALLOW_BROWSER_TOKEN_STORAGE=false
